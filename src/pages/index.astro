---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---
<Base>
  <Nav />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="hero-tag">Biegły sądowy · Ekspert finansów · Blockchain</div>
        <h1>Finanse, wyceny<br/>i nowe technologie<br/><span>w jednym miejscu</span></h1>
        <p class="hero-sub">
          Wpisany na listy biegłych sądowych ds. wyceny przedsiębiorstw, analizy utraconych korzyści
          i wycen udziałów w spółkach. Prezes Zarządu Instytutu Analiz i Ekspertyz Gospodarczych.
          Łączę świat prawa, finansów i technologii.
        </p>
        <div class="hero-ctas">
          <a href="#uslugi" class="btn-primary">Poznaj usługi</a>
          <a href="/baza-wiedzy" class="btn-secondary">Baza wiedzy</a>
        </div>
      </div>

      <div class="hero-photo-wrap">
        <div class="hero-photo-frame">
          <img src="/images/portret.jpg" alt="Tomasz Swaczyna" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="photo-placeholder">
            <span class="ph-icon">👤</span>
            <span class="ph-label">TOMASZ SWACZYNA</span>
          </div>
        </div>
        <div class="hero-badges">
          <span class="badge">⚖️ Biegły sądowy</span>
          <span class="badge">🔗 Blockchain SGH</span>
        </div>
      </div>

      <div class="hero-stats">
        <div><div class="stat-num">100+</div><div class="stat-label">Projektów konsultingowych</div></div>
        <div><div class="stat-num">6</div><div class="stat-label">Sądów okręgowych (wpis)</div></div>
        <div><div class="stat-num">15+</div><div class="stat-label">Lat doświadczenia</div></div>
        <div><div class="stat-num">3×</div><div class="stat-label">Wykształcenie (SGH + doktorat)</div></div>
      </div>
    </div>
  </section>

  <!-- O MNIE -->
  <section class="about" id="o-mnie">
    <div class="section-inner">
      <div class="section-tag">O mnie</div>
      <h2 class="section-title">Biegły, doradca, przedsiębiorca</h2>
      <p class="section-lead">Łączę kompetencje eksperta sądowego z wiedzą o nowoczesnych rynkach finansowych i technologii blockchain.</p>

      <div class="about-grid">
        <div>
          <div class="about-text">
            <p>Dyrektor zarządzający Kancelarii Doradztwa Ekonomicznego, prezes i założyciel Instytutu Analiz i Ekspertyz Gospodarczych (IAEG) oraz Metasy S.A. Absolwent studiów doktoranckich z zakresu ekonomii — rozprawa dotyczy wpływu innowacyjności przedsiębiorstw na ich wartość rynkową.</p>
            <p>Wpisany na listy biegłych sądowych przy Sądach Okręgowych w Warszawie, Szczecinie, Słupsku, Koszalinie, Gorzowie Wielkopolskim i Zielonej Górze. Specjalizacje: wycena przedsiębiorstw, analiza utraconych korzyści, wycena udziałów w spółkach, analizy OZE, kryptowaluty i NFT. Wpisany również na listy biegłych skarbowych w 15 z 16 Izb Administracji Skarbowej w Polsce.</p>
            <p>Autor wielu opinii sporządzanych na zlecenie sądów, izb administracji skarbowej i prokuratur. Uczestnik i prelegent międzynarodowych konferencji NFT i blockchain (Londyn, Nowy Jork, Paryż).</p>
          </div>
          <div class="about-highlights">
            <div class="highlight">
              <span class="hl-icon">🎓</span>
              <div>
                <div class="hl-title">Dyplom SGH — Blockchain &amp; Kryptowaluty</div>
                <div class="hl-desc">Studia podyplomowe, absolwent z wyróżnieniem. Członek Stowarzyszenia Ekspertów Blockchain.</div>
              </div>
            </div>
            <div class="highlight">
              <span class="hl-icon">📺</span>
              <div>
                <div class="hl-title">Media i konferencje</div>
                <div class="hl-desc">TVN24, Crypto Talks Warsaw 2026, NFT London, NFT NYC, Invest Cuffs.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="expertise-cards">
          <div class="exp-card">
            <div class="exp-card-head"><div class="exp-dot dot-gold">⚖️</div><h4>Biegły sądowy &amp; biegły skarbowy</h4></div>
            <p>Opinie i ekspertyzy na zlecenie sądów, prokuratur i izb administracji skarbowej. Specjalizacje: wycena przedsiębiorstw, analiza utraconych korzyści, wycena udziałów, aktywa cyfrowe.</p>
          </div>
          <div class="exp-card">
            <div class="exp-card-head"><div class="exp-dot dot-blue">💼</div><h4>Doradztwo finansowe &amp; wyceny</h4></div>
            <p>100+ projektów: analizy strategiczne, due diligence finansowe i prawne, pozyskiwanie dofinansowania B+R, wyceny M&amp;A.</p>
          </div>
          <div class="exp-card">
            <div class="exp-card-head"><div class="exp-dot dot-green">🔗</div><h4>Blockchain, NFT &amp; aktywa cyfrowe</h4></div>
            <p>Pionier rynku NFT w Polsce. Wycena tokenów i kolekcji NFT, analiza przepływów po sieci blockchain, opinie dla prokuratur i IAS. Ekspert Stowarzyszenia Ekspertów Blockchain.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- USŁUGI -->
  <section class="services" id="uslugi">
    <div class="section-inner">
      <div class="section-tag">Usługi</div>
      <h2 class="section-title">Czym mogę Ci pomóc?</h2>
      <p class="section-lead">Oferuję kompleksowe wsparcie eksperckie — od opinii sądowych po doradztwo w zakresie inwestycji i aktywów cyfrowych.</p>

      <div class="services-grid">
        {[
          { icon: '⚖️', title: 'Opinie biegłego sądowego', desc: 'Sporządzanie opinii i ekspertyz na zlecenie sądów, prokuratur, izb skarbowych. Wycena przedsiębiorstw, wierzytelności i aktywów cyfrowych w postępowaniach sądowych.' },
          { icon: '📊', title: 'Wyceny & Due Diligence', desc: 'Wyceny przedsiębiorstw (metody dochodowe, majątkowe, porównawcze), due diligence finansowe i prawne, ocena projektów inwestycyjnych, pozyskiwanie dofinansowania.' },
          { icon: '📉', title: 'Analiza utraconych korzyści', desc: 'Szacowanie wielkości ekonomicznych związanych z wyrządzeniem szkody lub utraconymi dochodami — w sprawach odszkodowawczych, naruszenia umów i nieuczciwej konkurencji.' },
          { icon: '⚖️', title: 'Podział majątku', desc: 'Wsparcie w określeniu wartości składników majątku przy podziale majątku wspólnego, dziedziczeniu i sprawach rodzinnych — wycena spółek, udziałów i aktywów cyfrowych.' },
          { icon: '🔗', title: 'Blockchain & Aktywa cyfrowe', desc: 'Wycena tokenów i kolekcji NFT, analiza przepływów po sieci blockchain, analizy rynków krypto, opinie dla instytucji, prokuratur i inwestorów.' },
          { icon: '📈', title: 'Finanse & Analizy rynkowe', desc: 'Analizy finansowe i rynkowe, ocena projektów inwestycyjnych, analizy utraconych korzyści. Inwestycje alternatywne: nieruchomości, OZE, kryptoaktywa.' },
          { icon: '🎤', title: 'Prelekcje & Szkolenia', desc: 'Wystąpienia na konferencjach, szkolenia korporacyjne z zakresu blockchain, kryptowalut, wycen i rynków finansowych.' },
          { icon: '🤝', title: 'Prawnicy, komornicy, syndycy', desc: 'Wyceny zajętych udziałów i praw majątkowych, analizy utraconych korzyści, opinie dla postępowań upadłościowych i egzekucyjnych.' },
          { icon: '💡', title: 'Doradztwo strategiczne', desc: 'Analiza strategiczna firm, restrukturyzacja, ocena innowacyjności. Wsparcie zarządów i właścicieli w kluczowych decyzjach biznesowych.' },
        ].map(s => (
          <div class="service-card">
            <span class="svc-icon">{s.icon}</span>
            <div class="svc-title">{s.title}</div>
            <p class="svc-desc">{s.desc}</p>
            <a href="#kontakt" class="svc-link">Zapytaj →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BAZA WIEDZY -->
  <section class="knowledge" id="baza-wiedzy-preview">
    <div class="section-inner">
      <div class="section-tag">Baza wiedzy</div>
      <h2 class="section-title">Artykuły &amp; Analizy</h2>
      <p class="section-lead">Finanse, inwestycje, blockchain i rynek nieruchomości — regularnie piszę o tym, co ważne dla inwestorów, przedsiębiorców i prawników.</p>

      <div class="articles-grid">
        {articles.length > 0 ? articles.map(a => (
          <a href={`/baza-wiedzy/${a.id}`} class="article-card">
            <div class="art-tag">{a.data.tag}</div>
            <div class="art-title">{a.data.title}</div>
            <p class="art-excerpt">{a.data.description}</p>
            <div class="art-meta"><span>{a.data.date}</span></div>
          </a>
        )) : (
          <>
            <div class="article-card">
              <div class="art-tag">Blockchain</div>
              <div class="art-title">Wycena kolekcji NFT — metody i pułapki</div>
              <p class="art-excerpt">Jak wycenić aktywa cyfrowe w postępowaniu sądowym? Przegląd metod i najczęstszych błędów.</p>
              <div class="art-meta"><span>Wkrótce</span></div>
            </div>
            <div class="article-card">
              <div class="art-tag">Wyceny</div>
              <div class="art-title">Due diligence finansowe — co sprawdzić przed zakupem spółki</div>
              <p class="art-excerpt">Kompleksowy przewodnik po audycie finansowym i prawnym przed transakcją M&A.</p>
              <div class="art-meta"><span>Wkrótce</span></div>
            </div>
            <div class="article-card">
              <div class="art-tag">Inwestycje</div>
              <div class="art-title">Inwestycje alternatywne — OZE, nieruchomości, crypto</div>
              <p class="art-excerpt">Analiza trzech głównych klas aktywów alternatywnych w obecnym otoczeniu makroekonomicznym.</p>
              <div class="art-meta"><span>Wkrótce</span></div>
            </div>
          </>
        )}
      </div>

      <div class="knowledge-cta">
        <a href="/baza-wiedzy" class="btn-primary">Wszystkie artykuły →</a>
      </div>
    </div>
  </section>

  <!-- MEDIA -->
  <section class="media-section" id="media">
    <div class="section-inner">
      <div class="section-tag">Media &amp; Wystąpienia</div>
      <h2 class="section-title">Rozpoznawalny ekspert</h2>
      <p class="section-lead">Komentator, prelegent i ekspert zapraszany przez media i organizatorów konferencji branżowych w Polsce i za granicą.</p>
      <div class="logos-row">
        {['📺 TVN24', '🎤 Crypto Talks Warsaw', '🌍 NFT London', '🗽 NFT NYC', '🇵🇱 Invest Cuffs', '🏛️ Puls Biznesu'].map(m => (
          <div class="media-logo">{m}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- KONTAKT -->
  <section class="contact" id="kontakt">
    <div class="section-inner">
      <div class="section-tag">Kontakt</div>
      <h2 class="section-title">Porozmawiajmy</h2>
      <p class="section-lead">Masz pytanie o wycenę, opinię biegłego lub współpracę? Napisz lub zadzwoń — odpowiadam w ciągu 24h.</p>

      <div class="contact-grid">
        <div class="contact-info">
          {[
            { icon: '📧', label: 'Email', value: 'tomasz.swaczyna@gmail.com' },
            { icon: '📞', label: 'Telefon', value: '+48 691 143 891' },
            { icon: '🏢', label: 'Firma', value: 'IAEG — Instytut Analiz i Ekspertyz Gospodarczych' },
            { icon: '⚖️', label: 'Biegły sądowy', value: 'SO Warszawa, Warszawa-Praga, Szczecin, Gdańsk, Wrocław, Słupsk, Koszalin, Gorzów Wlkp., Zielona Góra, Łódź, Rzeszów' },
            { icon: '🏛️', label: 'Biegły skarbowy', value: 'IAS Białystok, Bydgoszcz, Gdańsk, Katowice, Kielce, Lublin, Łódź, Olsztyn, Opole, Poznań, Rzeszów, Szczecin, Warszawa, Wrocław, Zielona Góra — 15 z 16 IAS w Polsce' },
          ].map(c => (
            <div class="contact-item">
              <div class="ci-icon">{c.icon}</div>
              <div><div class="ci-label">{c.label}</div><div class="ci-value">{c.value}</div></div>
            </div>
          ))}
        </div>

        <form class="contact-form" id="contactForm">
          <div class="form-row">
            <div class="form-field"><label>IMIĘ I NAZWISKO</label><input type="text" name="name" placeholder="Jan Kowalski" required /></div>
            <div class="form-field"><label>EMAIL</label><input type="email" name="email" placeholder="jan@firma.pl" required /></div>
          </div>
          <div class="form-field">
            <label>TEMAT</label>
            <select name="subject" id="formSubject">
              <option>Opinia biegłego sądowego</option>
              <option>Wycena przedsiębiorstwa</option>
              <option>Wycena udziału w spółkach</option>
              <option>Analiza utraconych korzyści</option>
              <option>Analiza ekonomiczna</option>
              <option>Podział majątku</option>
              <option>Doradztwo blockchain / NFT</option>
              <option>Prelekcja / szkolenie</option>
              <option>Inne</option>
            </select>
          </div>
          <div class="form-field"><label>WIADOMOŚĆ</label><textarea name="message" placeholder="Opisz krótko czego potrzebujesz..." required></textarea></div>
          <button type="submit" class="form-submit" id="formSubmit">Wyślij wiadomość →</button>
          <div id="formMsg" style="display:none;padding:12px 16px;border-radius:6px;font-size:.88rem;margin-top:4px;"></div>
        </form>
      </div>
    </div>
  </section>

  <script>
  const form = document.getElementById('contactForm');
  const btn = document.getElementById('formSubmit');
  const msg = document.getElementById('formMsg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Wysyłanie…';

    const data = new FormData(form);
    const subject = document.getElementById('formSubject')?.value || '';

    try {
      const res = await fetch('/api/kontakt', {
        method: 'POST',
        body: JSON.stringify({
          name: data.get('name'),
          email: data.get('email'),
          subject,
          message: data.get('message'),
        }),
        headers: { 'Content-Type': 'application/json' },
      });
      if (res.ok) {
        msg.style.display = 'block';
        msg.style.background = '#e6f4ea';
        msg.style.color = '#1a6b33';
        msg.textContent = '✅ Wiadomość wysłana! Odpiszę w ciągu 24h.';
        form.reset();
      } else {
        throw new Error('błąd serwera');
      }
    } catch {
      msg.style.display = 'block';
      msg.style.background = '#fdecea';
      msg.style.color = '#b71c1c';
      msg.textContent = '❌ Błąd wysyłania — napisz bezpośrednio na tomasz.swaczyna@gmail.com';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Wyślij wiadomość →';
    }
  });
  </script>

  <footer>
    <p>© 2026 <strong>Tomasz Swaczyna</strong> · bieglyofinansach.pl · Wszelkie prawa zastrzeżone</p>
  </footer>
</Base>

<style>
/* ── NAV ── */
nav { position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(13,27,42,.96);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:space-between;padding:0 5%;height:64px; }

/* ── HERO ── */
.hero { min-height:100vh;background:linear-gradient(135deg,var(--navy) 0%,var(--navy2) 60%,#1e3a5f 100%);display:flex;align-items:center;padding:80px 5% 60px;position:relative;overflow:hidden; }
.hero::before { content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 30 L30 0 L60 30 L30 60 Z' fill='none' stroke='rgba(200,169,110,.06)' stroke-width='1'/%3E%3C/svg%3E") repeat; }
.hero-inner { position:relative;max-width:1200px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 420px;gap:80px;align-items:center; }
.hero-tag { display:inline-flex;align-items:center;gap:8px;background:rgba(200,169,110,.15);border:1px solid rgba(200,169,110,.3);border-radius:20px;padding:6px 16px;margin-bottom:28px;font-size:.78rem;font-weight:600;color:var(--accent);letter-spacing:.08em;text-transform:uppercase; }
.hero-tag::before { content:'●';font-size:.5rem; }
.hero h1 { font-family:'Playfair Display',serif;font-size:clamp(2.4rem,4vw,3.6rem);color:#fff;line-height:1.15;margin-bottom:20px; }
.hero h1 span { color:var(--accent); }
.hero-sub { font-size:1.05rem;color:rgba(255,255,255,.7);line-height:1.7;margin-bottom:36px;max-width:540px; }
.hero-ctas { display:flex;gap:14px;flex-wrap:wrap; }
.btn-primary { background:var(--accent);color:var(--navy);padding:13px 28px;border-radius:6px;font-weight:700;font-size:.9rem;text-decoration:none;letter-spacing:.02em;transition:background .2s,transform .15s;display:inline-block; }
.btn-primary:hover { background:var(--accent2);transform:translateY(-1px); }
.btn-secondary { background:transparent;color:#fff;padding:13px 28px;border-radius:6px;font-weight:600;font-size:.9rem;text-decoration:none;letter-spacing:.02em;border:1.5px solid rgba(255,255,255,.35);transition:border-color .2s;display:inline-block; }
.btn-secondary:hover { border-color:var(--accent);color:var(--accent); }
.hero-photo-wrap { position:relative;display:flex;justify-content:center; }
.hero-photo-frame { width:360px;height:420px;background:linear-gradient(160deg,var(--navy2),#2a4a6e);border-radius:12px;overflow:hidden;border:2px solid rgba(200,169,110,.3);box-shadow:0 30px 80px rgba(0,0,0,.5); }
.hero-photo-frame img { width:100%;height:100%;object-fit:cover;object-position:top; }
.photo-placeholder { display:none;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:12px; }
.ph-icon { font-size:4rem;opacity:.3; }
.ph-label { color:rgba(255,255,255,.35);font-size:.8rem;letter-spacing:.1em; }
.hero-badges { position:absolute;bottom:-16px;left:50%;transform:translateX(-50%);display:flex;gap:10px;white-space:nowrap; }
.badge { background:#fff;border-radius:20px;padding:6px 14px;font-size:.72rem;font-weight:700;color:var(--navy);box-shadow:0 4px 16px rgba(0,0,0,.2);border:1px solid rgba(200,169,110,.3); }
.hero-stats { grid-column:1/-1;display:flex;gap:48px;margin-top:20px;padding-top:36px;border-top:1px solid rgba(255,255,255,.1); }
.stat-num { font-family:'Playfair Display',serif;font-size:2.2rem;color:var(--accent);font-weight:700; }
.stat-label { font-size:.8rem;color:rgba(255,255,255,.55);margin-top:2px; }

/* ── SHARED ── */
section { padding:96px 5%; }
.section-inner { max-width:1200px;margin:0 auto; }
.section-tag { font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:12px; }
.section-title { font-family:'Playfair Display',serif;font-size:clamp(1.8rem,3vw,2.6rem);color:var(--text);line-height:1.2;margin-bottom:16px; }
.section-lead { font-size:1.05rem;color:var(--muted);line-height:1.7;max-width:640px; }

/* ── ABOUT ── */
.about { background:var(--gray); }
.about-grid { display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;margin-top:56px; }
.about-text p { color:#3a4f62;line-height:1.8;margin-bottom:18px;font-size:.97rem; }
.about-highlights { display:flex;flex-direction:column;gap:20px;margin-top:32px; }
.highlight { display:flex;align-items:flex-start;gap:14px;background:#fff;border-radius:10px;padding:18px 20px;box-shadow:0 2px 12px rgba(0,0,0,.06);border-left:3px solid var(--accent); }
.hl-icon { font-size:1.4rem; }
.hl-title { font-weight:700;font-size:.92rem;color:var(--text);margin-bottom:3px; }
.hl-desc { font-size:.83rem;color:var(--muted);line-height:1.5; }
.expertise-cards { display:flex;flex-direction:column;gap:16px; }
.exp-card { background:#fff;border-radius:10px;padding:22px 24px;box-shadow:0 2px 12px rgba(0,0,0,.06); }
.exp-card-head { display:flex;align-items:center;gap:12px;margin-bottom:10px; }
.exp-dot { width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0; }
.dot-gold { background:rgba(200,169,110,.15); }
.dot-blue { background:rgba(30,90,160,.1); }
.dot-green { background:rgba(30,150,90,.1); }
.exp-card h4 { font-size:.92rem;font-weight:700;color:var(--text); }
.exp-card p { font-size:.83rem;color:var(--muted);line-height:1.55; }

/* ── SERVICES ── */
.services { background:#fff; }
.services-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:56px; }
.service-card { border:1.5px solid #e4e9ee;border-radius:12px;padding:32px 28px;transition:border-color .2s,box-shadow .2s; }
.service-card:hover { border-color:var(--accent);box-shadow:0 8px 32px rgba(200,169,110,.12); }
